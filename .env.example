# =================================================================
# ПАРАМЕТРЫ ОКРУЖЕНИЯ
# =================================================================
PROJECT_NAME=gruzbery_prod
EXTERNAL_DB_PORT=5433

# НАСТРОЙКИ БАЗЫ ДАННЫХ
DB_USER=postgres
DB_PASSWORD=пароль_сюда
DB_NAME=bybit_bot
# DB_URL формируется автоматически внутри docker-compose
REDIS_PASSWORD=пароль_redis_сюда
REDIS_URL=redis://:пароль_redis_сюда@redis:6379/0
REDIS_RAW_STREAM_NAME=csl:signals:raw
REDIS_READY_STREAM_NAME=csl:signals:ready
REDIS_STREAM_MAXLEN=1000
REDIS_ARTIST_CONSUMER_GROUP=csl:artist_group
REDIS_MESSENGER_CONSUMER_GROUP=csl:messenger_group
REDIS_CACHE_INVALIDATION_CHANNEL=csl:cache_invalidation
REDIS_CHART_CACHE_PREFIX=csl:chart_cache
REDIS_PENDING_IDLE_MS=30000

# API ТОКЕНЫ И ИНТЕГРАЦИИ
BOT_TOKEN=токен_бота_сюда
CRYPTOPAY_TOKEN=токен_криптопей_сюда
PRIVATE_CHANNEL_ID=-100...
LOG_CHANNEL_ID=-100...
NEWS_CHANNEL_ID=-100...
GUIDE_URL=ссылку_сюда

# =================================================================
# ПАРАМЕТРЫ РАБОТЫ
# =================================================================
# Прокси (оставь пустым на сервере, если не нужно)
PROXY_URL= 
# Список монет-исключений в формате JSON
IGNORED_SYMBOLS='["BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "DOGEUSDT", "ADAUSDT", "AVAXUSDT", "DOTUSDT"]'

# Режим работы крипто платежей
CRYPTOPAY_TESTNET=False
